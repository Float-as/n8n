    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const g = item.json;\n\n  return {\n    json: {\n      id: g.id,\n      title: g.title,\n      worth: g.worth,\n\n      thumbnail: g.thumbnail,\n      image: g.image,\n\n      description: g.description,\n      instructions: g.instructions,\n\n      giveawayUrl: g.open_giveaway_url,\n      gamerpowerUrl: g.gamerpower_url,\n\n      publishedDate: g.published_date,\n      endDate: g.end_date,\n\n      type: g.type,\n      platforms: g.platforms,\n\n      users: g.users,\n      status: g.status\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        0
      ],
      "id": "fbff49d7-4db6-4096-b5cb-905b24f3d679",
