    {
      "parameters": {
        "jsCode": "return items.filter(item => {\n  const g = item.json;\n\n  const endDate = g.end_date !== \"N/A\"\n    ? new Date(g.end_date)\n    : null;\n\n  return (\n    g.status === \"Active\" &&\n    (!endDate || endDate > new Date())\n  );\n});"
      },
